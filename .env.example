# ==============================================================================
# PROMPTVAULT ENVIRONMENT VARIABLES
# ==============================================================================

# --- CLIENT-SIDE (Vite Frontend) ---
# Required: Supabase project credentials (safe for browser client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Production domain for canonical URLs (defaults to https://promptvault.app)
VITE_SITE_URL=https://your-domain.vercel.app


# --- SERVER-SIDE ONLY (Vercel Serverless Functions: /api/*) ---
# NOTE: Never prefix secret tokens with VITE_. Set these in the Vercel Dashboard Settings -> Environment Variables.

# GitHub Image Upload Service
# Personal Access Token (PAT) with "repo" (or "contents:write" for fine-grained) scope
GITHUB_TOKEN=github_pat_your_secure_personal_access_token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-image-repository-name
GITHUB_BRANCH=main

# Supabase Serverless Mirror (Optional if VITE_ keys are set, but recommended for serverless API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SITE_URL=https://your-domain.vercel.app
